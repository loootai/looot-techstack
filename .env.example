# Token for real lookups and for the CLI without --dry-run. Create it in looot Settings, Agent tokens. The CLI reads the shell, not this file.
LOOOT_TOKEN=
# looot API base URL. Default https://api.looot.ai
# LOOOT_API_URL=
# State file the web app uses for stored answers. Default data/techstack.json
# TECHSTACK_DATA=
# Config file the web app reads. Default techstack.config.json
# TECHSTACK_CONFIG=
