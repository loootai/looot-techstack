# Admin password for the web app. 12 characters or more. Required outside the demo.
# Without it the admin pages and API stay closed and /login shows a setup page.
TECHSTACK_ADMIN_PASSWORD=
# Alternative to the plain password: the output of `npm run hash-password -- 'your password'`. Wins if both are set.
# TECHSTACK_ADMIN_PASSWORD_HASH=
# Optional. Key that signs session cookies. Default: derived from the password, so a new password signs everyone out.
# TECHSTACK_SESSION_SECRET=
# Optional. Set to 0 only to test over plain http in production mode. Leave unset otherwise.
# TECHSTACK_COOKIE_SECURE=

# Token for real lookups and for the CLI without --dry-run. Create it in looot Settings, Agent tokens. The CLI reads the shell, not this file.
LOOOT_TOKEN=
# looot API base URL. Default https://api.looot.ai
# LOOOT_API_URL=
# State file the web app uses for stored answers. Default data/techstack.json
# TECHSTACK_DATA=
# Config file the web app reads. Default techstack.config.json
# TECHSTACK_CONFIG=
